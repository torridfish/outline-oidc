# Copy of this file is written to .env by ./setup.sh, which fills in every placeholder.
# .env holds secrets: never commit it.

# --- Deployment ---
DOMAIN=__DOMAIN__
TUNNEL_NAME=outline
SITE_NAME=Outline
# Set this only to adopt volumes of an existing deployment (the default is "outline-oidc"):
# COMPOSE_PROJECT_NAME=outline-oidc

# --- Outline ---
NODE_ENV=production
URL=https://__DOMAIN__
PORT=3000
FORCE_HTTPS=false
SECRET_KEY=__SECRET_KEY__
UTILS_SECRET=__UTILS_SECRET__
DEFAULT_LANGUAGE=en_US
ENABLE_UPDATES=true
LOG_LEVEL=info
WEB_CONCURRENCY=2

POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DATABASE_URL=postgres://outline:__POSTGRES_PASSWORD__@postgres:5432/outline
DATABASE_CONNECTION_POOL_MIN=2
DATABASE_CONNECTION_POOL_MAX=10
PGSSLMODE=disable
REDIS_URL=redis://redis:6379
REDIS_COLLABORATION_URL=redis://redis:6379

FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data

# --- Outline <-> oidc-proxy ---
# The proxy does not check the secret; the client ID is the audience of the tokens it issues.
OIDC_CLIENT_ID=outline
OIDC_CLIENT_SECRET=__OIDC_CLIENT_SECRET__
OIDC_AUTH_URI=https://__DOMAIN__/oidc-proxy/authorize
OIDC_TOKEN_URI=http://oidc-proxy:9000/token
OIDC_USERINFO_URI=http://oidc-proxy:9000/userinfo
OIDC_SCOPES="openid profile email"
OIDC_DISPLAY_NAME=SSO
OIDC_PROXY_SIGNING_KEY=__SIGNING_KEY__

# --- Login providers: fill in at least one (see README) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
